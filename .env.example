# ═══════════════════════════════════════════════════════════
# 🔧 AI Chat Configuration
# ═══════════════════════════════════════════════════════════
# Active stack: AIChat -> Cloudflare Tunnel -> llama-server (llama.cpp) -> GGUF
# Run Collab-Llama.py (Colab) or Kaggle-Llama.py (Kaggle) to get BASE_URL/API_KEY.

# 🌐 BASE URL of your llama-server, via the Cloudflare Tunnel URL it prints.
# Replace with the URL printed by the notebook on each run/restart.
# Example: https://xxxx-xxxx-xxxx.trycloudflare.com
BASE_URL=

# 🔑 API Key (default from the notebooks: sk-colab-local / sk-kaggle-local)
API_KEY=

# 🤖 Free-text label only. llama-server serves a single loaded model, so
# this does not select/route between models the way it did with LiteLLM —
# it's just echoed in the request body for OpenAI-schema compatibility.
MODEL_NAME=character1

# 🌐 Port for local web server
PORT=3000

# 🌍 Interface Language (UI Language)
# Supported: EN, ID, JP, ES, FR, DE, ZH, RU, KO, AR, HI, PT
# Leave empty or set to EN for default English
UI_LANG=EN

# ═══════════════════════════════════════════════════════════
# ⚠️ DANGER / ALERT: DO NOT CHANGE IF YOU DON'T KNOW WHAT YOU ARE DOING
# ═══════════════════════════════════════════════════════════
# Native llama.cpp sampling parameters -- these map 1:1 to llama-server's
# own JSON body fields, no translation layer. MUST match the defaults set
# in Collab-Llama.py / Kaggle-Llama.py (see REPEAT_LAST_N etc. there) --
# whichever notebook you're running sets its own CLI startup defaults, but
# this app sends these explicitly on every request, which takes priority.
# Invalid values (non-numeric, out of range) are logged as a warning and
# fall back to the default shown below -- they are never silently ignored.

# ── Core generation ──
MAX_TOKENS=1024
TEMPERATURE=0.80
TOP_K=50
TOP_P=0.90
MIN_P=0.05
TYPICAL_P=1.0
TFS_Z=1.0
TOP_N_SIGMA=-1

# ── Thinking / Reasoning mode ──
# Always off by default to disable chain-of-thought tokens (<think>...</think>)
# on reasoning-capable models (e.g. Qwen 2.5/3, DeepSeek-R1). Set to true only if
# you want thinking tokens enabled.
ENABLE_THINKING=false

# ── Repetition control (windowed -- bounded to the last N tokens, not the
#    whole chat history) ──
REPEAT_LAST_N=256
REPEAT_PENALTY=1.05

# ── OpenAI-style penalties: cumulative over the WHOLE context by spec.
#    Left at 0 (disabled) on purpose -- see README for why. If you enable
#    these, remember they get worse the longer a chat gets. ──
PRESENCE_PENALTY=0.0
FREQUENCY_PENALTY=0.0

# ── DRY sampling: penalizes repeated phrases/loops, not individual common
#    words ("the"/"it"/"is") -- the recommended tool for long roleplay
#    chats that start feeling repetitive. ──
DRY_MULTIPLIER=0.8
DRY_BASE=1.75
DRY_ALLOWED_LENGTH=2
DRY_PENALTY_LAST_N=1024
DRY_SEQUENCE_BREAKERS=\n,:,",*

# ── XTC (off by default -- experimental) ──
XTC_PROBABILITY=0.0
XTC_THRESHOLD=0.1

# ── Dynamic temperature (off by default) ──
DYNATEMP_RANGE=0.0
DYNATEMP_EXP=1.0

# ── Mirostat (off by default -- when MIROSTAT != 0 it overrides
#    top_k/top_p/temperature) ──
MIROSTAT=0
MIROSTAT_LR=0.1
MIROSTAT_ENT=5.0

# ── Reproducibility ──
SEED=-1
# Comma-separated sampler chain order. Leave empty to use llama-server's
# own default chain.
SAMPLERS=
